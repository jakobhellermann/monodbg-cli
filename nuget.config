<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Self-contained: don't inherit machine-wide sources -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- Microsoft.SymbolStore / Microsoft.FileFormats are not published on nuget.org.
         They live in the .NET team's Azure DevOps "dotnet-tools" feed (source of dotnet-symbol). -->
    <add key="dotnet-tools" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet-tools/nuget/v3/index.json" />
  </packageSources>
</configuration>
