<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>monodbg</AssemblyName>
    <RootNamespace>MonoDbg</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <!-- vendor/ is a separate project (ProjectReference); keep it out of this project's compile cone -->
  <ItemGroup>
    <Compile Remove="vendor/**/*.cs" />
    <ProjectReference Include="vendor/Mono.Debugger.Soft/Mono.Debugger.Soft.csproj" />
  </ItemGroup>
</Project>
